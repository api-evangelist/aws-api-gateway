{
  "@context": {
    "@version": 1.1,
    "aws": "https://aws.amazon.com/schema/",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "Api": "aws:Api",
    "ApiId": {
      "@id": "aws:ApiId",
      "@type": "xsd:string"
    },
    "Name": {
      "@id": "aws:Name",
      "@type": "xsd:string"
    },
    "ProtocolType": {
      "@id": "aws:ProtocolType",
      "@type": "xsd:string"
    },
    "ApiEndpoint": {
      "@id": "aws:ApiEndpoint",
      "@type": "xsd:string"
    },
    "RouteSelectionExpression": {
      "@id": "aws:RouteSelectionExpression",
      "@type": "xsd:string"
    },
    "CreatedDate": {
      "@id": "aws:CreatedDate",
      "@type": "xsd:dateTime"
    }
  }
}