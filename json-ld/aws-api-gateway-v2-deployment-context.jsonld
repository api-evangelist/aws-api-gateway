{
  "@context": {
    "@version": 1.1,
    "aws": "https://aws.amazon.com/schema/",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "Deployment": "aws:Deployment",
    "DeploymentId": {
      "@id": "aws:DeploymentId",
      "@type": "xsd:string"
    },
    "Description": {
      "@id": "aws:Description",
      "@type": "xsd:string"
    },
    "DeploymentStatus": {
      "@id": "aws:DeploymentStatus",
      "@type": "xsd:string"
    },
    "CreatedDate": {
      "@id": "aws:CreatedDate",
      "@type": "xsd:dateTime"
    }
  }
}