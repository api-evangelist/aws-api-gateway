{
  "@context": {
    "@version": 1.1,
    "aws": "https://aws.amazon.com/schema/",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "ThrottleSettings": "aws:ThrottleSettings",
    "burstLimit": {
      "@id": "aws:burstLimit",
      "@type": "xsd:integer"
    },
    "rateLimit": {
      "@id": "aws:rateLimit",
      "@type": "xsd:decimal"
    }
  }
}