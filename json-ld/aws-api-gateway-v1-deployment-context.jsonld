{
  "@context": {
    "@version": 1.1,
    "aws": "https://aws.amazon.com/schema/",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "Deployment": "aws:Deployment",
    "id": {
      "@id": "aws:id",
      "@type": "xsd:string"
    },
    "description": "schema:description",
    "createdDate": {
      "@id": "aws:createdDate",
      "@type": "xsd:dateTime"
    }
  }
}