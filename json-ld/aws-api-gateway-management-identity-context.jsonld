    "Identity": "aws:Identity",
    "SourceIp": {
      "@id": "aws:SourceIp",
      "@type": "xsd:string"
    },
    "UserAgent": {
      "@id": "aws:UserAgent",
      "@type": "xsd:string"
    }
  }
}