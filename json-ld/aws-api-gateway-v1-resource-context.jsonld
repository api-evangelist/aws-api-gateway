{
  "@context": {
    "@version": 1.1,
    "aws": "https://aws.amazon.com/schema/",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "Resource": "aws:Resource",
    "id": {
      "@id": "aws:id",
      "@type": "xsd:string"
    },
    "parentId": {
      "@id": "aws:parentId",
      "@type": "xsd:string"
    },
    "pathPart": {
      "@id": "aws:pathPart",
      "@type": "xsd:string"
    },
    "path": {
      "@id": "aws:path",
      "@type": "xsd:string"
    }
  }
}