{
  "opencollection": "1.0.0",
  "info": {
    "name": "Amazon API Gateway Management ApiKeys Resources API",
    "version": "2018-11-29"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Resources",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Amazon API Gateway List Resources",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{api_id}.execute-api.{region}.amazonaws.com/{stage}/restapis/:restapi_id/resources",
            "params": [
              {
                "name": "restapi_id",
                "value": "",
                "type": "path",
                "description": "Identifier of the RestApi resource."
              }
            ]
          },
          "docs": "Lists the Resource resources for a RestApi."
        }
      ]
    }
  ],
  "bundled": true
}