{
  "opencollection": "1.0.0",
  "info": {
    "name": "Amazon API Gateway Management ApiKeys API",
    "version": "2018-11-29"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "ApiKeys",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Amazon API Gateway List API Keys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{api_id}.execute-api.{region}.amazonaws.com/{stage}/apikeys"
          },
          "docs": "Lists the ApiKeys for the caller's account."
        },
        {
          "info": {
            "name": "Amazon API Gateway Create an API Key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{api_id}.execute-api.{region}.amazonaws.com/{stage}/apikeys",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new ApiKey resource."
        }
      ]
    }
  ],
  "bundled": true
}