{
  "opencollection": "1.0.0",
  "info": {
    "name": "Amazon API Gateway Management ApiKeys Connections API",
    "version": "2018-11-29"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Connections",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Amazon API Gateway Get Connection Info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{api_id}.execute-api.{region}.amazonaws.com/{stage}/@connections/:connectionId",
            "params": [
              {
                "name": "connectionId",
                "value": "",
                "type": "path",
                "description": "Identifier of the WebSocket connection."
              }
            ]
          },
          "docs": "Retrieves information about the connection with the provided id."
        },
        {
          "info": {
            "name": "Amazon API Gateway Send Message to Connection",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{api_id}.execute-api.{region}.amazonaws.com/{stage}/@connections/:connectionId",
            "params": [
              {
                "name": "connectionId",
                "value": "",
                "type": "path",
                "description": "Identifier of the WebSocket connection."
              }
            ]
          },
          "docs": "Sends a message to the connected WebSocket client identified by connectionId."
        },
        {
          "info": {
            "name": "Amazon API Gateway Disconnect a Client",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{api_id}.execute-api.{region}.amazonaws.com/{stage}/@connections/:connectionId",
            "params": [
              {
                "name": "connectionId",
                "value": "",
                "type": "path",
                "description": "Identifier of the WebSocket connection."
              }
            ]
          },
          "docs": "Forcibly disconnects the WebSocket client identified by connectionId."
        }
      ]
    }
  ],
  "bundled": true
}