      "type": "object",
      "properties": {
        "SourceIp": {
          "type": "string",
          "description": "Source IP address of the client.",
          "example": "example-value"
        },
        "UserAgent": {
          "type": "string",
          "description": "User agent string from the client.",
          "example": "example-value"
        }
      }
    }
  },
